# ==============================================================================
# TELEBOROS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` or `.env.local` and fill in the values below.
# All features degrade gracefully: Teleboros runs out-of-the-box even if optional keys are omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SECURITY & COMPOSE AUTHENTICATION (Required for /compose)
# ------------------------------------------------------------------------------
# The master secret passphrase used to authorize publishing, AI condensation,
# and direct media uploads in the /compose Studio. Choose a strong random string.
ADMIN_TOKEN=your-strong-secret-token-here

# ------------------------------------------------------------------------------
# 2. TELEGRAM INTEGRATION (Required for Telegram Mirroring & Broadcasts)
# ------------------------------------------------------------------------------
# STEP-BY-STEP BOT CREATION WALKTHROUGH:
# 1. Open Telegram and start a chat with @BotFather (https://t.me/BotFather)
# 2. Send `/newbot` and follow the prompts to choose a bot name and unique username ending in 'bot'.
# 3. BotFather will provide an HTTP API Token (e.g. 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ). Paste it below:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 4. Create your public channel or use an existing one.
# 5. Open your channel settings -> Administrators -> Add Admin -> search for your bot username -> grant Post Messages permission.
# 6. For a public channel, specify the channel @handle (e.g. @mychannel).
#    For a private channel, forward a message from your channel to @userinfobot or @JsonDumpBot to get the numeric Chat ID (e.g. -1001234567890).
TELEGRAM_CHAT_ID=@your_channel_username

# (Optional) Webhook Secret for real-time automatic synchronization when new messages are posted
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-string

# ------------------------------------------------------------------------------
# 3. AI CONDENSATION (Optional — Graceful Fallback to Excerpts if Omitted)
# ------------------------------------------------------------------------------
# Google Gemini API key used by /compose to summarize long-form articles into
# concise, engaging Telegram teasers under 800 characters.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. STORAGE ADAPTERS (Universal Storage Architecture)
# ------------------------------------------------------------------------------
# Teleboros automatically selects the best available storage adapter in priority:
# 1. Cloudflare R2 (Recommended primary production adapter: zero egress fees, 10GB free)
# 2. Vercel Blob (Turnkey 1-click Vercel deployments)
# 3. Local Filesystem (Default fallback for Docker and VPS self-hosting)

# --- Option A: Cloudflare R2 (Recommended Primary) ---
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create Token (Object Read & Write)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_s3_access_key_id
# R2_SECRET_ACCESS_KEY=your_s3_secret_access_key
# R2_BUCKET_NAME=teleboros
# R2_PUBLIC_DOMAIN=https://pub-your-hash.r2.dev

# --- Option B: Vercel Blob Storage ---
# In Vercel Project Settings -> Storage -> Create Blob Store (automatically sets this variable)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ------------------------------------------------------------------------------
# 5. SITE METADATA & DEPLOYMENT
# ------------------------------------------------------------------------------
# Canonical public URL of your website (used for SEO canonical tags, RSS, and Telegram backlink buttons)
NEXT_PUBLIC_SITE_URL=https://my-teleboros-blog.vercel.app

# (Optional) Vercel Deploy Hook URL to trigger an automatic static rebuild after publishing
DEPLOY_HOOK_URL=

# ------------------------------------------------------------------------------
# 6. READER RETENTION & NEWSLETTER PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Teleboros includes an embedded "Subscribe to Updates" capture widget.
# If no provider is specified, subscribers are saved locally to data/subscribers.json.
# Supported providers: Resend, Buttondown, Mailchimp, or custom Webhook.

# --- Resend (https://resend.com) ---
# RESEND_API_KEY=re_123456789
# RESEND_AUDIENCE_ID=

# --- Buttondown (https://buttondown.email) ---
# BUTTONDOWN_API_KEY=

# --- Mailchimp (https://mailchimp.com) ---
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=us1
# MAILCHIMP_LIST_ID=

# --- Generic Webhook (Zapier, Make.com, n8n) ---
# NEWSLETTER_WEBHOOK_URL=https://webhook.site/...

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (Optional VAPID Keys)
# ------------------------------------------------------------------------------
# Generate VAPID keys by running: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
